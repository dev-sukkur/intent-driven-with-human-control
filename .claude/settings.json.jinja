{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(openspec list:*)",
      "Bash(openspec show:*)",
      "Bash(openspec status:*)",
      "Bash(openspec validate:*)",
{%- if acceptance_stack == 'python' %}
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format --check:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run vulture:*)",
      "Bash(uv run deptry:*)",
      "Bash(uv run --project acceptance-tests python acceptance-tests/run_acceptance.py:*)"
{%- else %}
      "Bash(bun test:*)",
      "Bash(bunx tsc --noEmit:*)",
      "Bash(bunx knip:*)",
      "Bash(npm test:*)",
      "Bash(npx cucumber-js:*)"
{%- endif %}
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
{%- if acceptance_stack == 'python' %}
            "command": "uv run --no-project python .claude/hooks/format_edited_file.py"
{%- else %}
            "command": "node .claude/hooks/format-edited-file.mjs"
{%- endif %}
          }
        ]
      }
    ]
  }
}
